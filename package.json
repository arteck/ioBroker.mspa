{
  "name": "iobroker.mspa",
  "version": "0.4.1",
  "description": "ioBroker adapter for MSpa Hot Tub cloud control",
  "main": "main.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arteck/ioBroker.mspa.git"
  },
  "keywords": [
    "mspa",
    "whirlpool",
    "ioBroker"
  ],
  "author": {
    "name": "Arthur Rupp",
    "email": "arteck@outlook.com"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/arteck/ioBroker.mspa/issues"
  },
  "homepage": "https://github.com/arteck/ioBroker.mspa#readme",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.1",
    "@iobroker/dm-utils": "^3.2.0",
    "axios": "^1.17.0",
    "crypto-js": "^4.2.0",
    "humanize-duration": "^3.34.0"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.0",
    "@alcalzone/release-script-plugin-manual-review": "^5.2.0",
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^5.2.2",
    "@tsconfig/node22": "^22.0.5",
    "@types/node": "^25.9.5",
    "@types/node-schedule": "^2.1.8",
    "typescript": "~6.0.3"
  },
  "files": [
    "admin{,/!(src)/**}/!(tsconfig|tsconfig.*).json",
    "admin{,/!(src)/**}/*.{html,css,png,svg,jpg,js}",
    "admin/i18n/",
    "lib/",
    "io-package.json",
    "LICENSE",
    "main.js"
  ],
  "scripts": {
    "test:js": "mocha --config test/mocharc.custom.json \"test/**/*.test.js\"",
    "test:package": "mocha test/package --exit",
    "test:integration": "mocha test/integration --exit",
    "test:logic": "node test/test_logic.js",
    "test": "npm run test:js && npm run test:package",
    "check": "tsc --noEmit -p tsconfig.check.json",
    "lint": "eslint .",
    "translate": "translate-adapter",
    "release": "release-script",
    "release-patch": "release-script patch --yes",
    "release-minor": "release-script minor --yes",
    "release-major": "release-script major --yes"
  },
  "readmeFilename": "README.md"
}
